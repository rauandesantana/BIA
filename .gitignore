# ==========================================
# .gitignore (BIA Stateless & Module Packs)
# ==========================================

# Ignorar o ambiente virtual (pesado e específico de cada máquina local)
venv/

# Ignorar ficheiros temporários e de cache gerados pelo Python
__pycache__/
*.pyc

# Ignorar os registos operacionais gerados em tempo de execução
logs/